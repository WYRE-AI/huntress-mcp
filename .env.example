# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway Compose service does not load these. Do not add them to that
# service's environment or via env_file.
HUNTRESS_API_KEY=
HUNTRESS_API_SECRET=

# stdio (default) or http
MCP_TRANSPORT=stdio

# Credential source for HTTP: env (process environment) or gateway (required
# X-Huntress-Api-Key and X-Huntress-Api-Secret headers; no env fallback).
# The container image and Compose set gateway. Stdio ignores this and reads
# HUNTRESS_* from the environment.
# AUTH_MODE=env

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, secret,
# replace-me, your-s2s-secret, and the other example values). Compose will
# not start when it is unset. Never commit a real value.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without CONDUIT_S2S_SECRET.
# The server logs a warning, does not check X-Gateway-S2S, and binds 127.0.0.1
# even if MCP_HTTP_HOST is a wider address such as 0.0.0.0. A known placeholder
# secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when CONDUIT_S2S_SECRET is set. When MCP_HTTP_HOST is unset,
# the HTTP server binds 127.0.0.1. The container image sets 0.0.0.0.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

LOG_LEVEL=info
